---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contato"
  description="Entre em contato com o Rotary Club de Novo Hamburgo 25 de Julho. E-mail, WhatsApp, localização e informações para doações e Empresa Cidadã."
>

  <!-- Header -->
  <section class="bg-gradient-to-br from-rotary-dark to-rotary-blue py-20">
    <div class="max-w-6xl mx-auto px-4">
      <p class="section-subtitle text-rotary-gold mb-2">Fale conosco</p>
      <h1 class="font-display text-5xl font-bold text-white mb-4">Contato</h1>
      <p class="text-blue-100 text-lg max-w-2xl">
        Quer colaborar, doe, torne-se membro ou simplesmente conhecer o clube? Estamos aqui.
      </p>
    </div>
  </section>

  <!-- Canais rápidos -->
  <section class="py-14 bg-white border-b border-gray-100">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-4 divide-y md:divide-y-0 md:divide-x divide-gray-100">
        <!-- E-mail -->
        <a href="mailto:contato@rotary25.com.br" class="flex items-center gap-4 p-6 hover:bg-rotary-light transition-colors group">
          <div class="w-10 h-10 border-2 border-rotary-blue flex items-center justify-center shrink-0 group-hover:bg-rotary-blue transition-colors">
            <svg class="h-5 w-5 text-rotary-blue group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <div>
            <p class="text-xs font-bold text-gray-400 uppercase tracking-wider">E-mail</p>
            <p class="text-rotary-blue font-semibold text-sm">contato@rotary25.com.br</p>
          </div>
        </a>
        <!-- WhatsApp -->
        <a href="https://wa.me/5551999761269" target="_blank" rel="noopener" class="flex items-center gap-4 p-6 hover:bg-rotary-light transition-colors group">
          <div class="w-10 h-10 border-2 border-rotary-blue flex items-center justify-center shrink-0 group-hover:bg-rotary-blue transition-colors">
            <svg class="h-5 w-5 text-rotary-blue group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </div>
          <div>
            <p class="text-xs font-bold text-gray-400 uppercase tracking-wider">WhatsApp</p>
            <p class="text-rotary-blue font-semibold text-sm">(51) 99976-1269</p>
          </div>
        </a>
        <!-- Sede -->
        <a href="https://maps.google.com/?q=Rua+Marcilio+Dias+1725+Novo+Hamburgo+RS" target="_blank" rel="noopener" class="flex items-center gap-4 p-6 hover:bg-rotary-light transition-colors group">
          <div class="w-10 h-10 border-2 border-rotary-blue flex items-center justify-center shrink-0 group-hover:bg-rotary-blue transition-colors">
            <svg class="h-5 w-5 text-rotary-blue group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
          <div>
            <p class="text-xs font-bold text-gray-400 uppercase tracking-wider">Sede</p>
            <p class="text-rotary-blue font-semibold text-sm">Rua Marcílio Dias, 1725<br/>Novo Hamburgo, RS</p>
          </div>
        </a>
        <!-- Instagram -->
        <a href="https://instagram.com/rotary25" target="_blank" rel="noopener" class="flex items-center gap-4 p-6 hover:bg-rotary-light transition-colors group">
          <div class="w-10 h-10 border-2 border-rotary-blue flex items-center justify-center shrink-0 group-hover:bg-rotary-blue transition-colors">
            <svg class="h-5 w-5 text-rotary-blue group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </div>
          <div>
            <p class="text-xs font-bold text-gray-400 uppercase tracking-wider">Instagram</p>
            <p class="text-rotary-blue font-semibold text-sm">@rotary25</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Formulário + Mapa -->
  <section class="py-20">
    <div class="max-w-6xl mx-auto px-4 grid lg:grid-cols-2 gap-12">

      <!-- Formulário -->
      <div>
        <p class="section-subtitle mb-2">Envie uma mensagem</p>
        <h2 class="section-title mb-6">Como podemos ajudar?</h2>

        <form
          name="contato-rotary"
          method="POST"
          data-netlify="true"
          class="space-y-5"
        >
          <input type="hidden" name="form-name" value="contato-rotary" />

          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1" for="nome">Nome completo *</label>
              <input type="text" id="nome" name="nome" required
                class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-rotary-blue focus:border-transparent transition" />
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1" for="email">E-mail *</label>
              <input type="email" id="email" name="email" required
                class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-rotary-blue focus:border-transparent transition" />
            </div>
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1" for="telefone">Telefone / WhatsApp</label>
            <input type="tel" id="telefone" name="telefone"
              class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-rotary-blue focus:border-transparent transition" />
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1" for="assunto">Assunto *</label>
            <select id="assunto" name="assunto" required
              class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-rotary-blue focus:border-transparent transition bg-white">
              <option value="">Selecione um assunto...</option>
              <option value="doacao">Quero fazer uma doação</option>
              <option value="empresa-cidada">Programa Empresa Cidadã</option>
              <option value="cafe-colonial">Café Colonial Drive-Thru</option>
              <option value="lacres">Doação de lacres / cadeiras de rodas</option>
              <option value="associacao">Interesse em me associar</option>
              <option value="imprensa">Imprensa / Parceria</option>
              <option value="outro">Outro assunto</option>
            </select>
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1" for="mensagem">Mensagem *</label>
            <textarea id="mensagem" name="mensagem" rows="5" required
              class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-rotary-blue focus:border-transparent transition resize-none"
              placeholder="Descreva como podemos ajudá-lo(a)..."></textarea>
          </div>

          <button type="submit" class="btn-primary w-full justify-center">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
            </svg>
            Enviar mensagem
          </button>
          <p class="text-xs text-gray-400 text-center">Respondemos em até 48 horas úteis.</p>
        </form>
      </div>

      <!-- Mapa e dados -->
      <div class="space-y-6">
        <div class="rounded-2xl overflow-hidden shadow-lg h-64">
          <iframe
            src="https://maps.google.com/maps?q=Rua+Marcílio+Dias+1725+Novo+Hamburgo+RS&output=embed"
            class="w-full h-full border-0"
            loading="lazy"
            title="Sede do Rotary NH 25 de Julho"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>

        <!-- PIX -->
        <div id="doe" class="bg-rotary-blue text-white rounded-2xl p-6">
          <h3 class="font-display text-xl font-bold mb-4">Faça uma Doação via PIX</h3>
          <p class="text-blue-100 text-sm mb-4">Qualquer valor transforma vidas. 100% revertido para os projetos do clube.</p>
          <div class="bg-white/10 rounded-xl p-4 mb-4">
            <p class="text-xs text-blue-200 font-semibold uppercase tracking-wider mb-1">Chave PIX (CNPJ)</p>
            <p class="font-bold text-2xl text-rotary-gold">16.366.682/0001-90</p>
          </div>
          <div class="text-sm text-blue-200 space-y-1">
            <p>Banco Sicredi · Ag. 0101 · CC 78255-7</p>
          </div>
        </div>

        <!-- Empresa Cidadã -->
        <div id="empresa-cidada" class="border-2 border-rotary-gold rounded-2xl p-6">
          <h3 class="font-display text-xl font-bold text-rotary-blue mb-3">Programa Empresa Cidadã</h3>
          <p class="text-gray-600 text-sm mb-4">
            Doação anual a partir de <strong>US$1.000</strong>. Receba o selo internacional, use como diferencial de ESG e deduza até <strong>2% do lucro operacional</strong>.
          </p>
          <ul class="space-y-2 text-sm text-gray-600 mb-4">
            <li class="flex items-center gap-2">
              <svg class="h-4 w-4 text-rotary-gold shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              100% dos valores chegam aos projetos
            </li>
            <li class="flex items-center gap-2">
              <svg class="h-4 w-4 text-rotary-gold shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Logomarca oficial para comunicações ESG
            </li>
            <li class="flex items-center gap-2">
              <svg class="h-4 w-4 text-rotary-gold shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Dedução fiscal até 2% do lucro operacional
            </li>
          </ul>
          <a href="mailto:contato@rotary25.com.br?subject=Programa%20Empresa%20Cidad%C3%A3" class="btn-primary w-full justify-center text-sm">
            Solicitar proposta Empresa Cidadã
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>
