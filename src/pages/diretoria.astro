---
import Layout from '../layouts/Layout.astro';

const presidente = {
  nome: 'Irineu Carlos Flesch',
  cargo: 'Presidente 2025/2026',
  destaque: true,
};

const pastPresidents = [
  { nome: 'Afonso José Nunes Pinto Jr.', cargo: 'Presidente 2024/2025' },
  { nome: 'Jorge Luiz Wojcicki da Silva', cargo: 'Presidente 2023/2024' },
  { nome: 'Heitor Luiz Borella', cargo: 'Presidente 2022/2023' },
  { nome: 'Lourdes Teresinha Ferla', cargo: 'Past President' },
];

const membros = [
  'Alvanir Carlos Hoffmann',
  'Carlos Roberto Escher',
  'Clóvis Daniel Berlitz',
  'Dagmar Spessatto',
  'Fábio Panitz',
  'Fabio Gomes da Silva',
  'Flávio Luiz Ribeiro da Rocha',
  'Gerson Luis Birk',
  'Ivan Faliguski',
  'Jairo Luís Brum',
  'Jauana Ereno Eidelwein',
  'João Luis Golgo Viana',
  'Juelcir José Savanim',
  'Luiz Francisco Scheid',
  'Marcio Arnold',
  'Marcio dos Santos',
  'Maria Cristina Siqueira de Andrade',
  'Marlize Fabiana de Souza',
  'Pedro Moacir Joazeiro',
  'Renilde Ninow',
  'Ronald Pedro Heidrich (in memoriam)',
  'Sérgio Siqueira Pacheco',
  'Simão Pedro Froehlich',
];

---

<Layout
  title="Diretoria"
  description="Conheça os membros e a diretoria atual do Rotary Club de Novo Hamburgo 25 de Julho — ano rotário 2025/2026."
>

  <!-- Header -->
  <section class="bg-gradient-to-br from-rotary-dark to-rotary-blue py-20">
    <div class="max-w-6xl mx-auto px-4">
      <p class="section-subtitle text-rotary-gold mb-2">Ano rotário 2025/2026</p>
      <h1 class="font-display text-5xl font-bold text-white mb-4">Nossa Diretoria</h1>
      <p class="text-blue-100 text-lg max-w-2xl">
        O Rotary opera sob mandatos anuais iniciados em 1º de julho. Conheça os líderes que guiam o clube neste ano rotário.
      </p>
    </div>
  </section>

  <!-- Presidente em Destaque -->
  <section class="py-20">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-14">
        <p class="section-subtitle mb-2">Liderança atual</p>
        <h2 class="section-title">Presidente 2025/2026</h2>
      </div>

      <div class="max-w-sm mx-auto">
        <div class="card text-center p-8 border-t-4 border-rotary-gold">
          <div class="w-32 h-32 rounded-full bg-gradient-to-br from-rotary-blue to-rotary-azure mx-auto mb-5 flex items-center justify-center">
            <span class="text-5xl text-white font-bold">
              {presidente.nome.split(' ').map((n: string) => n[0]).slice(0, 2).join('')}
            </span>
          </div>
          <h3 class="font-display text-2xl font-bold text-rotary-blue">{presidente.nome}</h3>
          <p class="text-rotary-gold font-semibold mt-1">{presidente.cargo}</p>
          <div class="mt-4 inline-flex items-center gap-1 bg-rotary-light text-rotary-blue text-xs font-bold px-3 py-1 rounded-full">
            <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
            Presidente em Exercício
          </div>
          <p class="text-gray-500 text-sm mt-4">
            Posse realizada em junho de 2026, priorizando companheirismo e a união do grupo.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Past Presidents -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-10">
        <p class="section-subtitle mb-2">Gestões recentes</p>
        <h2 class="section-title">Past Presidents</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {pastPresidents.map(pp => (
          <div class="card text-center p-6">
            <div class="w-16 h-16 rounded-full bg-gradient-to-br from-rotary-azure to-rotary-blue mx-auto mb-4 flex items-center justify-center">
              <span class="text-xl text-white font-bold">
                {pp.nome.split(' ').map((n: string) => n[0]).slice(0, 2).join('')}
              </span>
            </div>
            <h3 class="font-bold text-rotary-blue text-base">{pp.nome}</h3>
            <p class="text-gray-500 text-sm mt-1">{pp.cargo}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Membros Titulares -->
  <section class="py-20">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <p class="section-subtitle mb-2">Quadro associativo</p>
        <h2 class="section-title">Membros Titulares</h2>
        <p class="text-gray-500 mt-3 max-w-xl mx-auto">
          A adesão ao Rotary ocorre por apadrinhamento e convite formal a líderes profissionais alinhados eticamente à causa do serviço comunitário.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {membros.map(m => (
          <div class="bg-white border border-gray-100 rounded-xl p-4 flex items-center gap-3 shadow-sm hover:shadow-md transition-shadow">
            <div class="w-10 h-10 rounded-full bg-rotary-light flex items-center justify-center shrink-0">
              <span class="text-rotary-blue font-bold text-sm">
                {m.split(' ').map((n: string) => n[0]).filter((_: string, i: number) => i < 2).join('')}
              </span>
            </div>
            <p class="text-gray-700 font-medium text-sm leading-snug">{m}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Governança -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <p class="section-subtitle mb-2">Como funcionamos</p>
      <h2 class="section-title mb-6">Sistema de Governança</h2>
      <p class="text-gray-600 leading-relaxed max-w-2xl mx-auto mb-8">
        O Rotary opera sob um sistema de rodízio rigoroso. Os mandatos (chamados "anos rotários") iniciam-se em <strong>1º de julho</strong> e encerram em <strong>30 de junho</strong> do ano seguinte. Este sistema garante renovação constante de lideranças sem perder a continuidade institucional.
      </p>
      <div class="grid sm:grid-cols-3 gap-6 text-center">
        {[
          { icon: '🔄', title: 'Rodízio Anual', text: 'Nova diretoria eleita a cada 1º de julho' },
          { icon: '🤝', title: 'Apadrinhamento', text: 'Novos membros admitidos por convite e apadrinhamento' },
          { icon: '🌍', title: 'Rede Global', text: 'Conectados a +35.000 clubes em +200 países' },
        ].map(g => (
          <div class="bg-rotary-light rounded-xl p-6">
            <span class="text-4xl block mb-3">{g.icon}</span>
            <h3 class="font-bold text-rotary-blue mb-2">{g.title}</h3>
            <p class="text-gray-600 text-sm">{g.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>
