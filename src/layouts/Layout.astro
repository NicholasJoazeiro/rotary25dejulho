---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = 'Rotary Club de Novo Hamburgo 25 de Julho — Pessoas em Ação no Vale dos Sinos desde 1968.',
  image = '/images/logo.png',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonical} />
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} | Rotary NH 25 de Julho`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <title>{title} | Rotary Club NH 25 de Julho</title>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- Barra de Acessibilidade: painel + botão flutuante acima do WhatsApp -->
    <div id="a11y-panel" style="position:fixed;right:16px;bottom:148px;z-index:9997;display:none;background:#fff;border:1px solid #e5e7eb;box-shadow:0 -4px 24px rgba(0,0,0,.18);width:232px;max-height:70vh;overflow-y:auto;">
      <p style="font-weight:700;font-size:1rem;color:#1f2937;padding:14px 16px;border-bottom:1px solid #f3f4f6;line-height:1.3;position:sticky;top:0;background:#fff;">Ferramentas de<br/>Acessibilidade</p>
      <div style="padding:8px 0;">
        <button class="a11y-item" data-action="larger">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/><path d="M11 8v6M8 11h6"/></svg>
          Aumentar Texto
        </button>
        <button class="a11y-item" data-action="smaller">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/><path d="M8 11h6"/></svg>
          Diminuir Texto
        </button>
        <button class="a11y-item" data-action="grayscale">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="3" x2="9" y2="21"/><line x1="15" y1="3" x2="15" y2="21"/></svg>
          Escala de Cinza
        </button>
        <button class="a11y-item" data-action="contrast">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 3v18" /><path fill="currentColor" d="M12 3a9 9 0 0 1 0 18z"/></svg>
          Auto Contraste
        </button>
        <button class="a11y-item" data-action="negative">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/><line x1="2" y1="2" x2="22" y2="22"/></svg>
          Contraste Negativo
        </button>
        <button class="a11y-item" data-action="lightbg">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
          Fundo Claro
        </button>
        <button class="a11y-item" data-action="underline">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 3v7a6 6 0 0 0 12 0V3"/><line x1="4" y1="21" x2="20" y2="21"/></svg>
          Sublinhar Título
        </button>
        <button class="a11y-item" data-action="readable">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4 7 4 4 20 4 20 7"/><line x1="9" y1="20" x2="15" y2="20"/><line x1="12" y1="4" x2="12" y2="20"/></svg>
          Fonte Legível
        </button>
        <button class="a11y-item" data-action="reset" style="color:#dc2626;border-top:1px solid #f3f4f6;margin-top:4px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.45"/></svg>
          Redefinir
        </button>
      </div>
    </div>
    <button id="a11y-toggle" aria-label="Ferramentas de Acessibilidade" title="Ferramentas de Acessibilidade"
      style="position:fixed;right:24px;bottom:88px;z-index:9998;width:48px;height:48px;border-radius:50%;background:#00549F;color:#fff;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 16px rgba(0,84,159,.45);">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2a2 2 0 1 1 0 4 2 2 0 0 1 0-4zm8 7h-5v13h-2v-6h-2v6H9V9H4V7h16v2z"/>
      </svg>
    </button>

    <style is:global>
      .a11y-item {
        display: flex;
        align-items: center;
        gap: 10px;
        width: 100%;
        padding: 10px 16px;
        background: none;
        border: none;
        cursor: pointer;
        font-size: 0.875rem;
        color: #00549F;
        text-align: left;
        transition: background .15s;
      }
      .a11y-item:hover { background: #E8F4FC; }
      .a11y-item.active { background: #E8F4FC; font-weight: 700; }

      html.a11y-larger  { font-size: 120% !important; }
      html.a11y-smaller { font-size: 85%  !important; }
      html.a11y-grayscale { filter: grayscale(100%) !important; }
      html.a11y-negative  { filter: invert(100%) hue-rotate(180deg) !important; }
      html.a11y-contrast body  { background: #000 !important; color: #fff !important; }
      html.a11y-contrast a     { color: #ff0 !important; }
      html.a11y-contrast button{ background: #333 !important; color: #fff !important; }
      html.a11y-lightbg body   { background: #fffef0 !important; color: #000 !important; }
      html.a11y-underline h1,
      html.a11y-underline h2,
      html.a11y-underline h3,
      html.a11y-underline h4,
      html.a11y-underline h5,
      html.a11y-underline h6   { text-decoration: underline !important; }
      html.a11y-readable *     { font-family: Arial, Helvetica, sans-serif !important; }
    </style>

    <script>
      (function () {
        const html    = document.documentElement;
        const panel   = document.getElementById('a11y-panel');
        const toggle  = document.getElementById('a11y-toggle');
        const items   = document.querySelectorAll('.a11y-item');

        // mutually exclusive groups
        const exclusive = { larger: 'smaller', smaller: 'larger', grayscale: 'negative', negative: 'grayscale contrast', contrast: 'negative' };

        // restore saved state
        const saved = JSON.parse(localStorage.getItem('a11y') || '[]');
        saved.forEach(function(cls) { html.classList.add('a11y-' + cls); });
        syncButtons();

        toggle.addEventListener('click', function () {
          const hidden = panel.style.display === 'none';
          panel.style.display = hidden ? 'block' : 'none';
          toggle.style.background = hidden ? '#003366' : '#00549F';
        });

        items.forEach(function (btn) {
          btn.addEventListener('click', function () {
            const action = btn.dataset.action;
            if (action === 'reset') {
              ['larger','smaller','grayscale','negative','contrast','lightbg','underline','readable'].forEach(function(c){ html.classList.remove('a11y-' + c); });
            } else {
              // remove exclusive
              (exclusive[action] || '').split(' ').forEach(function(c){ if (c) html.classList.remove('a11y-' + c); });
              html.classList.toggle('a11y-' + action);
            }
            // save
            const active = ['larger','smaller','grayscale','negative','contrast','lightbg','underline','readable'].filter(function(c){ return html.classList.contains('a11y-' + c); });
            localStorage.setItem('a11y', JSON.stringify(active));
            syncButtons();
          });
        });

        function syncButtons() {
          items.forEach(function (btn) {
            if (btn.dataset.action === 'reset') return;
            btn.classList.toggle('active', html.classList.contains('a11y-' + btn.dataset.action));
          });
        }
      })();
    </script>

    <!-- WhatsApp flutuante -->
    <a
      href="https://wa.me/5551999761269"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Fale conosco pelo WhatsApp"
      class="fixed bottom-6 right-6 z-50 bg-green-500 hover:bg-green-600 text-white rounded-full w-14 h-14 flex items-center justify-center shadow-xl transition-colors"
    >
      <svg class="w-7 h-7" viewBox="0 0 24 24" fill="currentColor">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
    </a>
  </body>
</html>
