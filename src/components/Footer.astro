---
const currentYear = new Date().getFullYear();
---

<footer class="bg-rotary-dark text-white">
  <!-- Main footer -->
  <div class="max-w-6xl mx-auto px-4 py-14 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">

    <!-- Brand -->
    <div class="lg:col-span-1">
      <img src="/images/logo.png" alt="Rotary NH 25 de Julho" class="h-16 w-auto mb-4 brightness-0 invert" />
      <p class="text-gray-300 text-sm leading-relaxed">
        Fundado em 1968, o Rotary Club de Novo Hamburgo 25 de Julho é uma força viva de transformação no Vale dos Sinos.
      </p>
      <p class="mt-4 text-rotary-gold text-xs font-bold uppercase tracking-wider">Pessoas em Ação</p>
    </div>

    <!-- Navigation -->
    <div>
      <h3 class="font-bold text-rotary-gold uppercase tracking-wider text-sm mb-4">Navegação</h3>
      <ul class="space-y-2 text-gray-300 text-sm">
        {[
          ['/', 'Início'],
          ['/quem-somos', 'Quem Somos'],
          ['/diretoria', 'Diretoria'],
          ['/merito-profissional', 'Mérito Profissional'],
          ['/projetos', 'Projetos e Ações'],
          ['/noticias', 'Notícias'],
          ['/empresa-cidada', 'Empresa Cidadã'],
          ['/contato', 'Contato'],
        ].map(([href, label]) => (
          <li><a href={href} class="hover:text-white hover:underline transition-colors">{label}</a></li>
        ))}
      </ul>
    </div>

    <!-- Projetos -->
    <div>
      <h3 class="font-bold text-rotary-gold uppercase tracking-wider text-sm mb-4">Nossos Projetos</h3>
      <ul class="space-y-2 text-gray-300 text-sm">
        {[
          ['/projetos/robotica-nas-escolas', 'Robótica nas Escolas'],
          ['/projetos/nrdc-iluminar', 'NRDC Iluminar'],
          ['/projetos/cadeiras-de-rodas', 'Cadeiras de Rodas'],
          ['/projetos/cafe-colonial', 'Café Colonial Drive-Thru'],
        ].map(([href, label]) => (
          <li><a href={href} class="hover:text-white hover:underline transition-colors">{label}</a></li>
        ))}
      </ul>
    </div>

    <!-- Contact -->
    <div>
      <h3 class="font-bold text-rotary-gold uppercase tracking-wider text-sm mb-4">Contato</h3>
      <ul class="space-y-3 text-gray-300 text-sm">
        <li class="flex items-start gap-2">
          <svg class="h-4 w-4 mt-0.5 text-rotary-azure shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
          </svg>
          <span>Rua Marcílio Dias, 1725<br/>Novo Hamburgo, RS</span>
        </li>
        <li class="flex items-center gap-2">
          <svg class="h-4 w-4 text-rotary-azure shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"/>
            <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"/>
          </svg>
          <a href="mailto:contato@rotary25.com.br" class="hover:text-white transition-colors">contato@rotary25.com.br</a>
        </li>
        <li class="flex items-center gap-2">
          <svg class="h-4 w-4 text-rotary-azure shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          <a href="https://wa.me/5551999761269" target="_blank" rel="noopener" class="hover:text-white transition-colors">(51) 99976-1269</a>
        </li>
        <li class="flex items-center gap-2">
          <svg class="h-4 w-4 text-rotary-azure shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          <a href="https://instagram.com/rotary25" target="_blank" rel="noopener" class="hover:text-white transition-colors">@rotary25</a>
        </li>
      </ul>
    </div>
  </div>

  <!-- PIX Banner -->
  <div class="bg-rotary-blue py-4">
    <div class="max-w-6xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-3 text-sm">
      <p class="text-white font-semibold">Apoie nossos projetos via PIX:</p>
      <div class="flex items-center gap-3">
        <span class="bg-rotary-gold text-white font-bold px-4 py-1.5 rounded-lg text-sm">CNPJ: 16.366.682/0001-90</span>
        <span class="text-white opacity-70">ou Sicredi Ag. 0101 | CC 78255-7</span>
      </div>
    </div>
  </div>

  <!-- Copyright -->
  <div class="border-t border-white/10 py-4">
    <div class="max-w-6xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-gray-400">
      <p>© {currentYear} Rotary Club de Novo Hamburgo 25 de Julho. CNPJ 16.366.682/0001-90</p>
      <p>Fundado em 1968 · <em>Crie Impacto Duradouro</em></p>
    </div>
  </div>
</footer>
