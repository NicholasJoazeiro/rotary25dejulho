---
const navLinks = [
  { href: '/',                label: 'Início' },
  { href: '/projetos',        label: 'Projetos' },
  { href: '/noticias',        label: 'Notícias' },
  { href: '/empresa-cidada',  label: 'Empresa Cidadã' },
  { href: '/contato',         label: 'Contato' },
];

const clubeLinks = [
  { href: '/quem-somos',          label: 'Quem Somos' },
  { href: '/diretoria',           label: 'Diretoria' },
  { href: '/merito-profissional', label: 'Mérito Profissional' },
];

const currentPath = Astro.url.pathname;
const isClubePage = clubeLinks.some(l => currentPath.startsWith(l.href));
---

<!-- Top bar -->
<div class="bg-rotary-blue text-white text-sm hidden md:block">
  <div class="max-w-6xl mx-auto px-4 py-2 flex justify-between items-center">
    <div class="flex items-center gap-6">
      <a href="mailto:contato@rotary25.com.br" class="flex items-center gap-1.5 hover:text-rotary-gold transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
          <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"/>
          <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"/>
        </svg>
        contato@rotary25.com.br
      </a>
      <a href="https://wa.me/5551999761269" target="_blank" rel="noopener" class="flex items-center gap-1.5 hover:text-rotary-gold transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        (51) 99976-1269
      </a>
    </div>
    <div class="flex items-center gap-4">
      <span class="text-rotary-gold font-semibold">PIX: CNPJ 16.366.682/0001-90</span>
      <a href="https://instagram.com/rotary25" target="_blank" rel="noopener" class="hover:text-rotary-gold transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
      </a>
    </div>
  </div>
</div>

<!-- Main nav -->
<header class="bg-white shadow-sm sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 py-2 flex items-center justify-between">
    <a href="/" class="flex items-center gap-4">
      <img src="/images/logo.png" alt="Rotary Club NH 25 de Julho" class="h-20 w-auto" />
      <div class="hidden sm:block border-l border-gray-200 pl-4">
        <p class="text-xs text-gray-400 uppercase tracking-widest font-semibold leading-tight">Lema 2025/2026</p>
        <p class="text-rotary-blue font-bold text-lg leading-tight">Crie Impacto Duradouro</p>
      </div>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden lg:flex items-center gap-1">
      <a href="/" class={`px-3 py-2 rounded-lg font-semibold text-sm transition-colors duration-200 ${currentPath === '/' ? 'bg-rotary-blue text-white' : 'text-gray-700 hover:bg-rotary-light hover:text-rotary-blue'}`}>
        Início
      </a>

      <!-- Dropdown: O Clube -->
      <div class="relative group">
        <button class={`flex items-center gap-1 px-3 py-2 rounded-lg font-semibold text-sm transition-colors duration-200 ${isClubePage ? 'bg-rotary-blue text-white' : 'text-gray-700 hover:bg-rotary-light hover:text-rotary-blue'}`}>
          O Clube
          <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </button>
        <div class="absolute top-full left-0 pt-1 hidden group-hover:block z-50 min-w-48">
          <div class="bg-white shadow-lg border border-gray-100 rounded-lg py-2">
            {clubeLinks.map(link => (
              <a href={link.href} class={`block px-4 py-2.5 text-sm transition-colors ${currentPath === link.href ? 'text-rotary-blue font-bold bg-rotary-light' : 'text-gray-700 hover:bg-rotary-light hover:text-rotary-blue'}`}>
                {link.label}
              </a>
            ))}
          </div>
        </div>
      </div>

      {navLinks.filter(l => l.href !== '/').map(link => (
        <a
          href={link.href}
          class={`px-3 py-2 rounded-lg font-semibold text-sm transition-colors duration-200
            ${currentPath.startsWith(link.href)
              ? 'bg-rotary-blue text-white'
              : 'text-gray-700 hover:bg-rotary-light hover:text-rotary-blue'
            }`}
        >
          {link.label}
        </a>
      ))}
      <a href="/contato#doe" class="btn-primary ml-2 text-sm py-2 px-4">
        Doe agora
      </a>
    </nav>

    <!-- Mobile menu button -->
    <button id="menu-btn" class="lg:hidden p-2 rounded-lg text-rotary-blue hover:bg-rotary-light" aria-label="Menu">
      <svg id="icon-open"  class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
      <svg id="icon-close" class="h-6 w-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <!-- Mobile nav -->
  <nav id="mobile-menu" class="hidden lg:hidden border-t border-gray-100 bg-white">
    <div class="max-w-6xl mx-auto px-4 py-3 flex flex-col gap-1">
      <a href="/" class={`px-4 py-3 rounded-lg font-semibold transition-colors duration-200 ${currentPath === '/' ? 'bg-rotary-blue text-white' : 'text-gray-700 hover:bg-rotary-light'}`}>Início</a>
      <p class="px-4 pt-3 pb-1 text-xs font-bold text-gray-400 uppercase tracking-wider">O Clube</p>
      {clubeLinks.map(link => (
        <a href={link.href} class={`px-4 py-2.5 rounded-lg font-semibold transition-colors duration-200 text-sm ${currentPath === link.href ? 'bg-rotary-blue text-white' : 'text-gray-700 hover:bg-rotary-light'}`}>{link.label}</a>
      ))}
      <div class="border-t border-gray-100 mt-2 pt-2">
        {navLinks.filter(l => l.href !== '/').map(link => (
          <a href={link.href} class={`block px-4 py-3 rounded-lg font-semibold transition-colors duration-200 ${currentPath.startsWith(link.href) ? 'bg-rotary-blue text-white' : 'text-gray-700 hover:bg-rotary-light'}`}>{link.label}</a>
        ))}
      </div>
      <a href="/contato#doe" class="btn-primary mt-2 justify-center">Faça uma Doação</a>
    </div>
  </nav>
</header>

<script>
  const btn   = document.getElementById('menu-btn');
  const menu  = document.getElementById('mobile-menu');
  const open  = document.getElementById('icon-open');
  const close = document.getElementById('icon-close');

  btn?.addEventListener('click', () => {
    const isHidden = menu?.classList.toggle('hidden');
    open?.classList.toggle('hidden', !isHidden);
    close?.classList.toggle('hidden', isHidden);
  });
</script>
